-- 玩法节点配置（模板）
-- 多个 play 进程共用同一份模板，节点名统一为 play（节点名即节点类型），
-- 进程靠 server_id 区分，差异用 OS 环境变量：
--   SERVER_ID=55002 MCS_PORT=40102 ./skynet/skynet config/play_node
-- 不带环境变量时默认为 server_id=55001 的取值。
-- 注意：每个 play 进程必须在中心库 server_config 有对应的一行（nodeInfo 启动时校验）

thread = 8 --启用多少个工作线（玩法为计算密集，可按机型调高）
cpath = "./skynet/cservice/?.so" --用C编写的服务模块的位置
bootstrap = "snlua bootstrap" --启动的第一个服务
--bootstrap配置
start = "play" --主服务
harbor = 0 --不使用主从节点模式

--lua配置
lualoader = "./skynet/lualib/loader.lua"

-- lua服务
luaservice = "./tool/service/startup/?.lua;" ..			-- 起服相关
			"./tool/service/basic/?/?.lua;" ..			-- 基础设施功能（定时器、集群、数据库等等）
			"./game/service/?/?.lua;" ..				-- 游戏玩法逻辑服务
			"./skynet/service/?.lua;" ..				-- skynet内置服务
			"./skynet/examples/?.lua;" ..
			"./skynet/test/?.lua;"

lua_path = "./lualib/?.lua;" ..
			"./skynet/lualib/?.lua;" ..
			"./skynet/lualib/?/init.lua;" ..
			"./game/global/?.lua;" ..
			"./game/global/findpath/?.lua;"

lua_cpath = "./luaclib/?.so;" .. "./skynet/luaclib/?.so;" .. "./tool/cplugins-so/?.so"

--后台模式（必要时开启）
-- daemon = "./log/skynet.pid"
-- logger = "./log/skynet_error.log"

profile = true		-- 默认位true的
profile_cmd = true	-- 细化指令检测

apreload = "tool/luaplugins/apreload.lua"  -- 目的：main完成必要的操作后 才对后续服务开放加载节点数据
preload = "tool/luaplugins/preload.lua"
-- game_preload = ... 	-- 内部设置

------------------ 节点信息 ------------------
cluster_no = 1				-- 集群编号

-- 节点身份：节点名即节点类型，所有 play 进程统一为 play；server_id 用环境变量区分进程
node_name = "play"
server_id = 55001

nowaiting = true			-- 不挂起【其中利弊还未考量】
gcluster_auths = "!#df@&%s1idf"
is_testserver = true		-- 测试服

gcluster_padding_warn = 100	-- 分包数量警告

------------------ 数据库 ------------------
database_cachecnt = 100		-- 每个数据库链接缓存数据数量
database_num = 10			-- 每个链接数据库的个数
database_info = [[{
